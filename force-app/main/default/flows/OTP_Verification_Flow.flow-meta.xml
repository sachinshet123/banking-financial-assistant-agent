<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>To assign OTP Valid status</description>
        <name>OTP_Found_Message</name>
        <label>OTP Found Message</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>OTPValidityMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>OTP is Valid</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Is_Verified</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>To assign OTP Valid status</description>
        <name>OTP_Not_Found_Message</name>
        <label>OTP Not Found Message</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>OTPValidityMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>OTP is Not Valid</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Decision to check if OTP Record get is successful or Failure</description>
        <name>Decision_to_check_Record_Existence</name>
        <label>Decision to check Record Existence</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OTP_Record_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>To_get_OTP_Verification_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OTP_Found_Message</targetReference>
            </connector>
            <label>OTP Record Found</label>
        </rules>
        <rules>
            <name>OTP_Record_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>To_get_OTP_Verification_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OTP_Not_Found_Message</targetReference>
            </connector>
            <label>OTP Record Not Found</label>
        </rules>
    </decisions>
    <description>Flow to validate if Customer given otp is valid or not</description>
    <environments>Default</environments>
    <interviewLabel>OTP Verification Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>OTP Verification Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>To get record from OTP Verification object and to validate</description>
        <name>To_get_OTP_Verification_Record</name>
        <label>To get OTP Verification Record</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_to_check_Record_Existence</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>emailId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Generated_OTP__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Otp</elementReference>
            </value>
        </filters>
        <filters>
            <field>Is_Verified__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OTP__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Is_Verified</name>
        <label>Update Is Verified</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>emailId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Is_Verified__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>OTP__c</object>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>To_get_OTP_Verification_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>To store email Id from agentforce</description>
        <name>emailId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>To Store otp from agentforce</description>
        <name>Otp</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>OTPValidityMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
